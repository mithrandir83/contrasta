---
import debate from '../../../data/debate.json';
import claims from '../../../data/published.json';
const topics = [...new Set(claims.map(c=>c.topic))].sort();
const verdicts = [...new Set(claims.map(c=>c.verdict))].sort();
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Contrasta · Los datos frente al discurso</title><meta name="description" content="Verificación documentada de afirmaciones en debates públicos."/></head><body>
<header><div class="wrap top"><a class="brand" href="#inicio">contrasta<span>.</span></a><nav><a href="#afirmaciones">Afirmaciones</a><a href="#metodologia">Metodología</a></nav></div></header>
<main class="wrap" id="inicio"><section class="hero"><p class="eyebrow">ELECCIONES GENERALES · 26 NOV 2026</p><h1>El debate, bajo la lupa.</h1><p class="lead">Qué se dijo, qué sabemos y qué evidencias lo respaldan. Un registro abierto y auditable del discurso público.</p><a href={debate.video_url} rel="noopener noreferrer">Consultar grabación original ↗</a></section>
<section class="summary"><div><strong>{claims.length}</strong><span>Verificaciones publicadas</span></div><div><strong>{debate.participants.length}</strong><span>Candidatos incluidos</span></div><div><strong>{new Set(claims.flatMap(c=>c.sources.map(s=>s.url))).size}</strong><span>Fuentes documentadas</span></div></section>
<section id="afirmaciones"><h2>Explorar afirmaciones</h2><p class="muted">Solo se publican fichas revisadas. La cobertura aún no es exhaustiva.</p><div class="filters"><label>Buscar<input id="q" type="search" placeholder="Tema, dato, palabra…"/></label><label>Candidato<select id="person"><option value="">Todos</option>{debate.participants.map(p=><option>{p}</option>)}</select></label><label>Tema<select id="topic"><option value="">Todos</option>{topics.map(t=><option>{t}</option>)}</select></label><label>Veredicto<select id="verdict"><option value="">Todos</option>{verdicts.map(v=><option>{v}</option>)}</select></label></div>
<p id="count" role="status" aria-live="polite">{claims.length} resultados</p>
<div id="cards">{claims.map(c=><article data-person={c.person} data-topic={c.topic} data-verdict={c.verdict}><p class="eyebrow">{c.person} · {c.topic}</p><h3>{c.claim}</h3><p><strong>{c.verdict}</strong> · {c.start != null ? `${Math.floor(c.start/60)}:${String(Math.floor(c.start%60)).padStart(2,'0')}` : 'Minuto pendiente'}</p>{c.quote && <blockquote>«{c.quote}»</blockquote>}<p class="analysis">{c.analysis}</p><h4>Fuentes</h4><ul>{c.sources.map(s=><li><a href={s.url} rel="noopener noreferrer">{s.title}</a></li>)}</ul><p class="muted">Revisión: {c.reviewed_at}</p></article>)}</div>
{claims.length===0 && <div class="empty"><h3>Investigación en preparación</h3><p>No hay verificaciones revisadas todavía. No publicaremos citas, atribuciones o veredictos sin comprobar.</p></div>}
<p id="no-results" hidden>No hay resultados para estos filtros.</p></section>
<section id="metodologia"><h2>Cómo verificamos</h2><p>Transcribimos, comprobamos la atribución y el contexto, separamos afirmaciones factuales, consultamos fuentes primarias y documentamos los cálculos. Aplicamos los mismos criterios a todas las personas. Las opiniones y promesas no reciben un juicio de veracidad factual. Una conclusión automática nunca se publica sin revisión humana.</p><p><a href="https://www.rtve.es/noticias/20261126/debate-cuatro-verificacion-datos-elecciones-generales-2026/17330993.shtml">Verificación independiente de RTVE (material de contraste)</a></p><p>Los datos podrán corregirse con un historial público. No se publican archivos audiovisuales sin autorización.</p></section></main><footer class="wrap">Contrasta · Proyecto en desarrollo · <a href={`${import.meta.env.BASE_URL.replace(/\/$/,'')}/datos.json`}>Datos abiertos JSON</a></footer>
<script>const ids=['q','person','topic','verdict'];function filter(){const val=id=>document.getElementById(id)?.value||'';const normalize=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();let n=0;document.querySelectorAll('#cards article').forEach(el=>{const show=normalize(el.textContent||'').includes(normalize(val('q'))) && ['person','topic','verdict'].every(k=>!val(k)||el.dataset[k]===val(k));el.hidden=!show;if(show)n++;});document.getElementById('count').textContent=`${n} resultados`;document.getElementById('no-results').hidden=n!==0||!document.querySelector('#cards article');}ids.forEach(id=>document.getElementById(id)?.addEventListener('input',filter));</script>
<style is:global>*,*:before,*:after{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#faf9f6;color:#182322;font:16px/1.6 system-ui,sans-serif}a{color:#1b6663;text-underline-offset:4px}header{border-bottom:1px solid #ddd} .wrap{max-width:1020px;margin:auto;padding:0 24px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:76px}nav{display:flex;gap:16px;font-size:.9rem}.brand{font-size:1.8rem;font-weight:850;letter-spacing:-.07em;text-decoration:none;color:#182322}.brand span{color:#1b6663}.hero{padding:68px 0 45px}.eyebrow{font-size:.76rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:#526561}h1{font:700 clamp(2.7rem,7vw,5rem)/1.02 Georgia,serif;letter-spacing:-.045em;margin:16px 0}.lead{font-size:1.2rem;max-width:650px;color:#43504f}.summary{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #b8c3bf;border-bottom:1px solid #b8c3bf;padding:22px 0;gap:16px}.summary strong{font-size:2.2rem;display:block}.summary span,.muted{color:#5d6664;font-size:.9rem}section:not(.hero):not(.summary){padding:36px 0;border-bottom:1px solid #ddd}h2{font:700 2rem Georgia,serif}.filters{display:grid;grid-template-columns:2fr 1.2fr 1fr 1fr;gap:12px}.filters label{font-size:.8rem;font-weight:650}input,select{display:block;width:100%;padding:11px 8px;font:inherit;background:white;border:1px solid #bfc9c6;border-radius:4px;margin-top:5px;color:inherit}article,.empty{border:1px solid #d4dcd8;background:white;padding:24px;margin:14px 0;border-radius:5px}h3{font-size:1.25rem;margin:4px 0}.analysis{white-space:pre-wrap}blockquote{border-left:3px solid #8cb2aa;margin:15px 0;padding-left:16px}footer{padding:25px 24px!important;font-size:.85rem;color:#5d6664}[hidden]{display:none!important}@media(max-width:680px){.filters{grid-template-columns:1fr 1fr}.hero{padding:40px 0}.top{flex-wrap:wrap;padding-block:12px}.summary strong{font-size:1.7rem}.summary span{font-size:.75rem}}</style></body></html>
